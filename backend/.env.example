# Copy this file to .env and change the values:  cp .env.example .env

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL). Use DB_ENGINE=sqlite only for quick tests.
DB_ENGINE=postgres
DB_NAME=konark_bank
DB_USER=konark_user
DB_PASSWORD=ChangeThisPassword123
DB_HOST=127.0.0.1
DB_PORT=5432

# Frontend URL(s) allowed to call the API (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Needed only in production (your live frontend/backend URLs, with https://)
CSRF_TRUSTED_ORIGINS=

# In production, hosts usually give one URL instead (this overrides the DB_* values above):
# DATABASE_URL=postgres://user:password@host:5432/dbname
